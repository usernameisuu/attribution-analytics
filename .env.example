# Only configure on the chosen remote host. Never commit real credentials.
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_URL_SAFE_PASSWORD
BOOTSTRAP_USERNAME=analyst
BOOTSTRAP_ROLE=analyst
BOOTSTRAP_PASSWORD=CHANGE_TO_RANDOM_PASSWORD_AT_LEAST_16_CHARS
PUBLIC_ORIGIN=https://your-domain.example
SECURE_COOKIE=true
# Only the worker receives the provider credential. Leave empty for rules mode.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Verify current maximum (cache-miss) prices in CNY per million tokens.
# Zero/missing or verification older than 7 days blocks paid requests.
MODEL_INPUT_CNY_PER_MILLION=0
MODEL_OUTPUT_CNY_PER_MILLION=0
MODEL_PRICE_VERIFIED_ON=
# Cumulative 25 CNY cap is enforced by the DB ledger AND the gateway;
# changing an environment variable cannot increase it.
